generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionScopeType {
  GSS
  COMPANY
  BOTH
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum AccessLevel {
  VIEW
  MANAGE
}

enum BuildingImageKind {
  PLAN
  REAL
}

enum PositionAssignmentStatus {
  ACTIVE
  ENDED
}

enum DeviceLifecycleStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum GatewayType {
  NODES_GATEWAY
  SECURITY_OFFICE_GATEWAY
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum GatewayCommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
  EXPIRED
  CANCELLED
}

enum GatewayCommandType {
  REGISTER_NODES
  WAKE_SECURITY
  SET_ALARM_LEVELS
  SET_FAULT_FILTER
}

enum SensorReadingStatus {
  SAFE
  CAUTION
  WARNING
  DANGER
  OFFLINE
  UNCONFIGURED
}

enum AuditActorType {
  GSS_ADMIN
  COMPANY_USER
  SYSTEM
}

model Permission {
  id                String                   @id @default(uuid()) @db.Uuid
  key               String                   @unique
  module            String
  action            String
  scopeType         PermissionScopeType
  description       String?
  gssRoleLinks      GssRolePermission[]
  gssAdminUserLinks GssAdminUserPermission[]
  companyRoleLinks  CompanyRolePermission[]
  companyUserLinks  CompanyUserPermission[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model GssRole {
  id           String              @id @default(uuid()) @db.Uuid
  key          String              @unique
  name         String
  isSuperAdmin Boolean             @default(false)
  isSystem     Boolean             @default(false)
  users        GssAdminUser[]
  permissions  GssRolePermission[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model GssAdminUser {
  id           String                   @id @default(uuid()) @db.Uuid
  roleId       String                   @db.Uuid
  role         GssRole                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  name         String
  email        String                   @unique
  passwordHash String
  phone        String?
  isActive     Boolean                  @default(true)
  tokenVersion Int                      @default(0)
  lastLoginAt  DateTime?
  permissions  GssAdminUserPermission[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model GssRolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         GssRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model GssAdminUserPermission {
  adminUserId  String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect @default(ALLOW)
  adminUser    GssAdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([adminUserId, permissionId])
}

model Company {
  id                       String                            @id @default(uuid()) @db.Uuid
  name                     String
  code                     String?                           @unique
  address                  String?
  phone                    String?
  email                    String?
  logoKey                  String?
  status                   CompanyStatus                     @default(ACTIVE)
  areas                    ConstructionArea[]
  buildings                ConstructionBuilding[]
  deviceAssignments        CompanyDeviceAssignment[]
  provisioningRequests     NodeGatewayProvisioningRequest[]
  alarmLevelConfigurations BuildingAlarmLevelConfiguration[]
  latestNodeStates         LatestNodeState[]
  roles                    CompanyRole[]
  sensorReadings           SensorReading[]
  users                    CompanyUser[]
  positions                CompanyPosition[]
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
}

model ConstructionArea {
  id                  String                          @id @default(uuid()) @db.Uuid
  companyId           String                          @db.Uuid
  company             Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name                String
  address             String?
  description         String?
  status              CompanyStatus                   @default(ACTIVE)
  buildings           ConstructionBuilding[]
  latestNodeStates    LatestNodeState[]
  sensorReadings      SensorReading[]
  userAccess          CompanyUserAreaAccess[]
  positionAssignments CompanyUserPositionAssignment[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@unique([companyId, name])
}

model ConstructionBuilding {
  id                       String                            @id @default(uuid()) @db.Uuid
  companyId                String                            @db.Uuid
  areaId                   String                            @db.Uuid
  company                  Company                           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  area                     ConstructionArea                  @relation(fields: [areaId], references: [id], onDelete: Restrict)
  title                    String
  number                   String?
  address                  String?
  buildingType             String?
  startDate                DateTime?
  status                   CompanyStatus                     @default(ACTIVE)
  userAccess               CompanyUserBuildingAccess[]
  planImages               BuildingPlanImage[]
  positionAssignments      CompanyUserPositionAssignment[]
  gatewayAssignments       GatewayBuildingAssignment[]
  provisioningRequests     NodeGatewayProvisioningRequest[]
  alarmLevelConfigurations BuildingAlarmLevelConfiguration[]
  alarmLevelApplications   GatewayAlarmLevelApplication[]
  latestNodeStates         LatestNodeState[]
  sensorReadings           SensorReading[]
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt

  @@unique([areaId, title])
}

model NodeType {
  id                       String                            @id @default(uuid()) @db.Uuid
  key                      String                            @unique
  displayName              String
  numericCode              Int                               @unique
  imageAssetKey            String
  latestStates             LatestNodeState[]
  nodes                    Node[]
  provisioningRequests     NodeGatewayProvisioningRequest[]
  alarmLevelConfigurations BuildingAlarmLevelConfiguration[]
  alarmLevelApplications   GatewayAlarmLevelApplication[]
  faultFilterDesiredStates GatewayFaultFilterDesiredState[]
  faultFilterAppliedStates GatewayFaultFilterAppliedState[]
  sensorReadings           SensorReading[]
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
}

model Gateway {
  id                       String                           @id @default(uuid()) @db.Uuid
  serialNumber             String                           @unique
  gatewayType              GatewayType
  status                   DeviceLifecycleStatus            @default(ACTIVE)
  installedLocation        String?
  lastSeenAt               DateTime?
  companyAssignments       CompanyDeviceAssignment[]
  buildingAssignments      GatewayBuildingAssignment[]
  nodeAssignments          NodeGatewayAssignment[]
  commands                 GatewayCommand[]
  provisioningRequests     NodeGatewayProvisioningRequest[]
  alarmLevelApplications   GatewayAlarmLevelApplication[]
  faultFilterDesiredStates GatewayFaultFilterDesiredState[]
  faultFilterAppliedStates GatewayFaultFilterAppliedState[]
  latestNodeStates         LatestNodeState[]
  sensorReadings           SensorReading[]
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
}

model Node {
  id                       String                           @id @default(uuid()) @db.Uuid
  nodeTypeId               String                           @db.Uuid
  nodeType                 NodeType                         @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)
  number                   String                           @unique
  status                   DeviceLifecycleStatus            @default(ACTIVE)
  installedLocation        String?
  batteryLevel             Int?
  lastSeenAt               DateTime?
  companyAssignments       CompanyDeviceAssignment[]
  gatewayAssignments       NodeGatewayAssignment[]
  provisioningItems        NodeGatewayProvisioningItem[]
  faultFilterDesiredStates GatewayFaultFilterDesiredState[]
  faultFilterAppliedStates GatewayFaultFilterAppliedState[]
  latestState              LatestNodeState?
  sensorReadings           SensorReading[]
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
}

model CompanyDeviceAssignment {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @db.Uuid
  gatewayId    String?          @db.Uuid
  nodeId       String?          @db.Uuid
  status       AssignmentStatus @default(ACTIVE)
  assignedAt   DateTime         @default(now())
  unassignedAt DateTime?
  activeKey    String           @default("active")
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  gateway      Gateway?         @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  node         Node?            @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@unique([gatewayId, activeKey])
  @@unique([nodeId, activeKey])
  @@index([companyId, status])
}

model GatewayBuildingAssignment {
  id           String               @id @default(uuid()) @db.Uuid
  gatewayId    String               @db.Uuid
  buildingId   String               @db.Uuid
  status       AssignmentStatus     @default(ACTIVE)
  assignedAt   DateTime             @default(now())
  unassignedAt DateTime?
  activeKey    String               @default("active")
  gateway      Gateway              @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  building     ConstructionBuilding @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  @@unique([gatewayId, activeKey])
  @@index([buildingId, status])
}

model NodeGatewayAssignment {
  id               String                       @id @default(uuid()) @db.Uuid
  nodeId           String                       @db.Uuid
  gatewayId        String                       @db.Uuid
  status           AssignmentStatus             @default(ACTIVE)
  assignedAt       DateTime                     @default(now())
  unassignedAt     DateTime?
  activeKey        String                       @default("active")
  sourceCommandId  String?                      @db.Uuid
  node             Node                         @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  gateway          Gateway                      @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  provisioningItem NodeGatewayProvisioningItem?

  @@unique([nodeId, activeKey])
  @@index([gatewayId, status])
  @@index([sourceCommandId])
}

model GatewayCommand {
  id                            String                           @id @default(uuid()) @db.Uuid
  gatewayId                     String                           @db.Uuid
  gateway                       Gateway                          @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  commandType                   GatewayCommandType
  commandNumber                 Int
  status                        GatewayCommandStatus             @default(PENDING)
  topic                         String
  payload                       Json
  responsePayload               Json?
  requesterType                 AuditActorType
  requesterId                   String?                          @db.Uuid
  correlationKey                String
  activeKey                     String                           @default("active")
  attemptCount                  Int                              @default(0)
  maxAttempts                   Int                              @default(3)
  lastAttemptAt                 DateTime?
  sentAt                        DateTime?
  acknowledgedAt                DateTime?
  failedAt                      DateTime?
  expiresAt                     DateTime
  cancelledAt                   DateTime?
  failureReason                 String?
  provisioningRequest           NodeGatewayProvisioningRequest?
  alarmLevelDesiredApplications GatewayAlarmLevelApplication[]   @relation("AlarmLevelDesiredCommand")
  alarmLevelAppliedApplications GatewayAlarmLevelApplication[]   @relation("AlarmLevelAppliedCommand")
  faultFilterDesiredStates      GatewayFaultFilterDesiredState[] @relation("FaultFilterDesiredCommand")
  faultFilterAppliedStates      GatewayFaultFilterAppliedState[] @relation("FaultFilterAppliedCommand")
  createdAt                     DateTime                         @default(now())
  updatedAt                     DateTime                         @updatedAt

  @@unique([gatewayId, commandNumber, activeKey])
  @@unique([correlationKey, activeKey])
  @@index([gatewayId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model BuildingAlarmLevelConfiguration {
  id                  String                                   @id @default(uuid()) @db.Uuid
  companyId           String                                   @db.Uuid
  buildingId          String                                   @db.Uuid
  nodeTypeId          String                                   @db.Uuid
  enabled             Boolean                                  @default(true)
  cautionThreshold    Float?
  warningThreshold    Float?
  dangerThreshold     Float?
  version             Int                                      @default(1)
  updatedByType       AuditActorType
  updatedById         String?                                  @db.Uuid
  createdAt           DateTime                                 @default(now())
  updatedAt           DateTime                                 @updatedAt
  company             Company                                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  building            ConstructionBuilding                     @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  nodeType            NodeType                                 @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)
  history             BuildingAlarmLevelConfigurationHistory[]
  gatewayApplications GatewayAlarmLevelApplication[]

  @@unique([buildingId, nodeTypeId])
  @@index([companyId])
  @@index([nodeTypeId])
}

model BuildingAlarmLevelConfigurationHistory {
  id               String                          @id @default(uuid()) @db.Uuid
  configurationId  String                          @db.Uuid
  version          Int
  enabled          Boolean
  cautionThreshold Float?
  warningThreshold Float?
  dangerThreshold  Float?
  updatedByType    AuditActorType
  updatedById      String?                         @db.Uuid
  createdAt        DateTime                        @default(now())
  configuration    BuildingAlarmLevelConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([configurationId, version])
  @@index([createdAt])
}

model GatewayAlarmLevelApplication {
  id                          String                          @id @default(uuid()) @db.Uuid
  buildingId                  String                          @db.Uuid
  gatewayId                   String                          @db.Uuid
  nodeTypeId                  String                          @db.Uuid
  configurationId             String                          @db.Uuid
  configurationVersion        Int
  desiredEnabled              Boolean                         @default(true)
  desiredCommandId            String?                         @db.Uuid
  desiredStatus               GatewayCommandStatus            @default(PENDING)
  appliedConfigurationId      String?                         @db.Uuid
  appliedConfigurationVersion Int?
  appliedEnabled              Boolean?
  appliedCommandId            String?                         @db.Uuid
  appliedRequestId            String?                         @db.Uuid
  lastSuccessfulPayload       Json?
  appliedAt                   DateTime?
  failureReason               String?
  updatedByType               AuditActorType
  updatedById                 String?                         @db.Uuid
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  building                    ConstructionBuilding            @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  gateway                     Gateway                         @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  nodeType                    NodeType                        @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)
  configuration               BuildingAlarmLevelConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  desiredCommand              GatewayCommand?                 @relation("AlarmLevelDesiredCommand", fields: [desiredCommandId], references: [id], onDelete: SetNull)
  appliedCommand              GatewayCommand?                 @relation("AlarmLevelAppliedCommand", fields: [appliedCommandId], references: [id], onDelete: SetNull)

  @@unique([buildingId, gatewayId, nodeTypeId])
  @@index([desiredCommandId])
  @@index([appliedCommandId])
  @@index([gatewayId, desiredStatus])
  @@index([configurationId])
}

model GatewayFaultFilterDesiredState {
  id               String               @id @default(uuid()) @db.Uuid
  gatewayId        String               @db.Uuid
  nodeTypeId       String               @db.Uuid
  nodeId           String               @db.Uuid
  enabled          Boolean              @default(true)
  desiredCommandId String?              @db.Uuid
  desiredStatus    GatewayCommandStatus @default(PENDING)
  failureReason    String?
  updatedByType    AuditActorType
  updatedById      String?              @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  gateway          Gateway              @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  nodeType         NodeType             @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)
  node             Node                 @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  desiredCommand   GatewayCommand?      @relation("FaultFilterDesiredCommand", fields: [desiredCommandId], references: [id], onDelete: SetNull)

  @@unique([gatewayId, nodeTypeId, nodeId])
  @@index([desiredCommandId])
  @@index([gatewayId, nodeTypeId, desiredStatus])
}

model GatewayFaultFilterAppliedState {
  id                    String               @id @default(uuid()) @db.Uuid
  gatewayId             String               @db.Uuid
  nodeTypeId            String               @db.Uuid
  nodeId                String               @db.Uuid
  applied               Boolean              @default(false)
  appliedCommandId      String?              @db.Uuid
  appliedRequestId      String?              @db.Uuid
  lastSuccessfulPayload Json?
  appliedAt             DateTime?
  status                GatewayCommandStatus @default(PENDING)
  failureReason         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  gateway               Gateway              @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  nodeType              NodeType             @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)
  node                  Node                 @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  appliedCommand        GatewayCommand?      @relation("FaultFilterAppliedCommand", fields: [appliedCommandId], references: [id], onDelete: SetNull)

  @@unique([gatewayId, nodeTypeId, nodeId])
  @@index([appliedCommandId])
  @@index([gatewayId, nodeTypeId, applied])
}

model NodeGatewayProvisioningRequest {
  id              String                        @id @default(uuid()) @db.Uuid
  commandId       String                        @unique @db.Uuid
  companyId       String                        @db.Uuid
  buildingId      String                        @db.Uuid
  gatewayId       String                        @db.Uuid
  nodeTypeId      String                        @db.Uuid
  status          GatewayCommandStatus          @default(PENDING)
  responsePayload Json?
  failureReason   String?
  requestedByType AuditActorType
  requestedById   String?                       @db.Uuid
  appliedAt       DateTime?
  failedAt        DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  command         GatewayCommand                @relation(fields: [commandId], references: [id], onDelete: Restrict)
  company         Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  building        ConstructionBuilding          @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  gateway         Gateway                       @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  nodeType        NodeType                      @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)
  items           NodeGatewayProvisioningItem[]

  @@index([companyId, status])
  @@index([buildingId, status])
  @@index([gatewayId, status])
  @@index([createdAt])
}

model NodeGatewayProvisioningItem {
  id            String                         @id @default(uuid()) @db.Uuid
  requestId     String                         @db.Uuid
  nodeId        String                         @db.Uuid
  assignmentId  String?                        @unique @db.Uuid
  appliedAt     DateTime?
  failureReason String?
  request       NodeGatewayProvisioningRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  node          Node                           @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  assignment    NodeGatewayAssignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@unique([requestId, nodeId])
  @@index([nodeId])
}

model SensorReading {
  id                     String               @id @default(uuid()) @db.Uuid
  companyId              String               @db.Uuid
  areaId                 String               @db.Uuid
  buildingId             String               @db.Uuid
  gatewayId              String               @db.Uuid
  nodeId                 String               @db.Uuid
  nodeTypeId             String               @db.Uuid
  status                 SensorReadingStatus
  values                 Json
  classificationEvidence Json?
  faultFiltered          Boolean              @default(false)
  measuredAt             DateTime?
  receivedAt             DateTime             @default(now())
  deduplicationKey       String               @unique
  deduplicationSource    String
  sourceTopic            String?
  gatewayMessageId       String?
  gatewaySequence        String?
  valueHash              String
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  area                   ConstructionArea     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  building               ConstructionBuilding @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  gateway                Gateway              @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  node                   Node                 @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  nodeType               NodeType             @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)

  @@index([buildingId, nodeTypeId, receivedAt])
  @@index([gatewayId, receivedAt])
  @@index([nodeId, receivedAt])
  @@index([receivedAt])
}

model LatestNodeState {
  id                     String               @id @default(uuid()) @db.Uuid
  companyId              String               @db.Uuid
  areaId                 String               @db.Uuid
  buildingId             String               @db.Uuid
  gatewayId              String               @db.Uuid
  nodeId                 String               @unique @db.Uuid
  nodeTypeId             String               @db.Uuid
  status                 SensorReadingStatus
  values                 Json
  classificationEvidence Json?
  faultFiltered          Boolean              @default(false)
  lastSeenAt             DateTime
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  area                   ConstructionArea     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  building               ConstructionBuilding @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  gateway                Gateway              @relation(fields: [gatewayId], references: [id], onDelete: Restrict)
  node                   Node                 @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  nodeType               NodeType             @relation(fields: [nodeTypeId], references: [id], onDelete: Restrict)

  @@index([buildingId, nodeTypeId, updatedAt])
  @@index([gatewayId])
  @@index([lastSeenAt])
}

model CompanyRole {
  id                 String                  @id @default(uuid()) @db.Uuid
  companyId          String?                 @db.Uuid
  company            Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key                String
  name               String
  isSystem           Boolean                 @default(false)
  isCompanyOwnerRole Boolean                 @default(false)
  users              CompanyUser[]
  permissions        CompanyRolePermission[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([companyId, key])
}

model CompanyUser {
  id                  String                          @id @default(uuid()) @db.Uuid
  companyId           String                          @db.Uuid
  roleId              String                          @db.Uuid
  company             Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role                CompanyRole                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  name                String
  email               String                          @unique
  passwordHash        String
  phone               String?
  isActive            Boolean                         @default(true)
  tokenVersion        Int                             @default(0)
  lastLoginAt         DateTime?
  permissions         CompanyUserPermission[]
  areaAccess          CompanyUserAreaAccess[]
  buildingAccess      CompanyUserBuildingAccess[]
  positionAssignments CompanyUserPositionAssignment[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
}

model BuildingPlanImage {
  id         String               @id @default(uuid()) @db.Uuid
  buildingId String               @db.Uuid
  building   ConstructionBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  kind       BuildingImageKind
  storageKey String
  orderIndex Int
  width      Int?
  height     Int?
  createdAt  DateTime             @default(now())

  @@unique([buildingId, kind, orderIndex])
}

model CompanyPosition {
  id          String                          @id @default(uuid()) @db.Uuid
  companyId   String                          @db.Uuid
  company     Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key         String
  name        String
  isActive    Boolean                         @default(true)
  assignments CompanyUserPositionAssignment[]
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt

  @@unique([companyId, key])
}

model CompanyUserPositionAssignment {
  id            String                   @id @default(uuid()) @db.Uuid
  companyUserId String                   @db.Uuid
  positionId    String                   @db.Uuid
  areaId        String?                  @db.Uuid
  buildingId    String?                  @db.Uuid
  status        PositionAssignmentStatus @default(ACTIVE)
  assignedAt    DateTime                 @default(now())
  endedAt       DateTime?
  companyUser   CompanyUser              @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  position      CompanyPosition          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  area          ConstructionArea?        @relation(fields: [areaId], references: [id], onDelete: Restrict)
  building      ConstructionBuilding?    @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  @@index([companyUserId, status])
  @@index([positionId, status])
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  actorType  AuditActorType
  actorId    String?        @db.Uuid
  action     String
  entityType String
  entityId   String?        @db.Uuid
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
}

model CompanyRolePermission {
  roleId       String      @db.Uuid
  permissionId String      @db.Uuid
  role         CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model CompanyUserPermission {
  companyUserId String           @db.Uuid
  permissionId  String           @db.Uuid
  effect        PermissionEffect @default(ALLOW)
  companyUser   CompanyUser      @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  permission    Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([companyUserId, permissionId])
}

model CompanyUserAreaAccess {
  companyUserId String           @db.Uuid
  areaId        String           @db.Uuid
  accessLevel   AccessLevel      @default(VIEW)
  companyUser   CompanyUser      @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  area          ConstructionArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([companyUserId, areaId])
}

model CompanyUserBuildingAccess {
  companyUserId String               @db.Uuid
  buildingId    String               @db.Uuid
  accessLevel   AccessLevel          @default(VIEW)
  companyUser   CompanyUser          @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  building      ConstructionBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@id([companyUserId, buildingId])
}
