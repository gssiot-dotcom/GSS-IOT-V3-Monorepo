[Unit]
Description=GSS IoT V3 production containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/gss-iot
ExecStart=/usr/bin/docker compose --env-file /opt/gss-iot/release.env --file /opt/gss-iot/docker-compose.production.yml up --detach
ExecStop=/usr/bin/docker compose --env-file /opt/gss-iot/release.env --file /opt/gss-iot/docker-compose.production.yml down
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
