NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://gss_iot_v3:gss_iot_v3@localhost:5432/gss_iot_v3?schema=public
DELETION_WORKER_ENABLED=true
DELETION_WORKER_INTERVAL_MS=5000
DELETION_WORKER_BATCH_SIZE=250
DELETION_WORKER_HEARTBEAT_MS=5000
DELETION_WORKER_LEASE_MS=30000
# Private company-logo assets: local in development, memory in tests, S3 in production.
ASSET_STORAGE_PROVIDER=local
ASSET_LOCAL_STORAGE_DIR=.data/assets
# Required only when ASSET_STORAGE_PROVIDER=s3.
# ASSET_S3_ENDPOINT=https://s3.example.com
# ASSET_S3_REGION=ap-northeast-2
# ASSET_S3_BUCKET=gss-private-assets
# ASSET_S3_ACCESS_KEY_ID=replace-with-secret-reference
# ASSET_S3_SECRET_ACCESS_KEY=replace-with-secret-reference
# ASSET_S3_FORCE_PATH_STYLE=false
REPORT_WORKER_ENABLED=true
REPORT_WORKER_INTERVAL_MS=30000
REPORT_WORKER_BATCH_SIZE=10
REPORT_CLEANUP_ENABLED=true
REPORT_CLEANUP_INTERVAL_MS=300000
REPORT_CLEANUP_BATCH_SIZE=100
# Use local for development, memory for tests, and s3 in production.
REPORT_STORAGE_PROVIDER=local
REPORT_LOCAL_STORAGE_DIR=.data/report-exports
# Required only when REPORT_STORAGE_PROVIDER=s3.
# REPORT_S3_ENDPOINT=https://s3.example.com
# REPORT_S3_REGION=ap-northeast-2
# REPORT_S3_BUCKET=gss-report-exports
# REPORT_S3_ACCESS_KEY_ID=replace-with-secret-reference
# REPORT_S3_SECRET_ACCESS_KEY=replace-with-secret-reference
# REPORT_S3_FORCE_PATH_STYLE=false
# The API is an MQTT client. Point this at the separately operated physical broker.
MQTT_BROKER_URL=mqtt://gssiot.iptime.org:10200
MQTT_CLIENT_ID=gss-iot-v3-api
MQTT_COMMAND_ACK_TIMEOUT_MS=30000
MQTT_COMMAND_EXPIRES_IN_SECONDS=300
MQTT_ENABLED=false
MQTT_FAKE_ACK=false
MQTT_MAX_PUBLISH_ATTEMPTS=3
MQTT_PUBLISH_TIMEOUT_MS=5000
MQTT_TOPIC_BASE=GSSIOT/01030369081
MQTT_USERNAME=
MQTT_PASSWORD=
NODE_OFFLINE_EVALUATOR_ENABLED=true
NODE_OFFLINE_SWEEP_INTERVAL_MS=10000
NODE_OFFLINE_BATCH_SIZE=250
SENSOR_RETENTION_ENABLED=false
SENSOR_RETENTION_DRY_RUN=true
SENSOR_RETENTION_DAYS=180
SENSOR_RETENTION_INTERVAL_MS=3600000
SENSOR_RETENTION_BATCH_SIZE=1000
SENSOR_RETENTION_MAX_ROWS_PER_CYCLE=10000
# Phase 12 notifications use in-app delivery only. Do not add SMS/Telegram/email/web-push
# credentials until provider vendors and secret handling are approved.
JWT_ACCESS_SECRET=replace-with-a-distinct-minimum-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-distinct-minimum-32-character-refresh-secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Required when Web and API use sibling subdomains; use their shared parent domain.
# AUTH_COOKIE_DOMAIN=.example.com
AUTH_ACCESS_COOKIE_NAME=gss_access
AUTH_REFRESH_COOKIE_NAME=gss_refresh
AUTH_CSRF_COOKIE_NAME=gss_csrf
GSS_SUPER_ADMIN_EMAIL=admin@example.com
GSS_SUPER_ADMIN_PASSWORD=change-this-super-admin-password
